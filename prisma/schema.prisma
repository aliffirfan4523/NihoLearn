generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String             @id @default(cuid())
  email           String             @unique
  name            String?
  avatarUrl       String?
  provider        String             @default("email")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  kanaProgress    KanaProgress[]
  vocabProgress   VocabProgress[]
  kanjiProgress   KanjiProgress[]
  grammarProgress GrammarProgress[]
  studySessions   StudySession[]
}

model Kana {
  id        String @id
  character String
  type      String
  romaji    String
  row       String

  progress KanaProgress[]
}

model KanaProgress {
  id         String    @id @default(cuid())
  userId     String
  kanaId     String
  status     String    @default("unlearned")
  masteredAt DateTime?
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  kana Kana @relation(fields: [kanaId], references: [id], onDelete: Cascade)

  @@unique([userId, kanaId])
}

model Kanji {
  id            String   @id
  character     String   @unique
  strokes       Int?
  radicalNumber Int?
  frequency     Int?
  jlpt          String   // "N5", "N4", "N3", "N2", "N1"
  meaning       String
  onyomi        String?  // JSON array string e.g. '["ジン", "ニン"]'
  kunyomi       String?  // JSON array string e.g. '["ひと", "-り"]'
  examples      String?  // JSON array string of example compound words
  begins        Int?
  usedIn        Int?
  componentIn   Int?
  description   String?

  progress KanjiProgress[]

  @@index([jlpt])
}

model VocabProgress {
  id           String    @id @default(cuid())
  userId       String
  wordId       String
  level        String
  status       String    @default("unlearned")
  notes        String?
  nextReviewAt DateTime?
  masteredAt   DateTime?
  addedAt      DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
}

model KanjiProgress {
  id          String    @id @default(cuid())
  userId      String
  kanjiId     String
  level       String
  status      String    @default("unlearned")
  notes       String?
  masteredAt  DateTime?
  updatedAt   DateTime  @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  kanji Kanji? @relation(fields: [kanjiId], references: [character], onDelete: Cascade)

  @@unique([userId, kanjiId])
}

model GrammarProgress {
  id          String    @id @default(cuid())
  userId      String
  grammarId   String
  level       String
  status      String    @default("unlearned")
  notes       String?
  masteredAt  DateTime?
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, grammarId])
}

model StudySession {
  id              String   @id @default(cuid())
  userId          String
  date            DateTime @default(now())
  durationMinutes Int
  level           String
  activities      String
  wordsReviewed   Int?
  kanjiReviewed   Int?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
